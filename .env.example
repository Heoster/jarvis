# ─────────────────────────────────────────────────────────────────────
#  JARVIS — environment file.  Copy to `.env` and fill in what you have.
#  Everything here is FREE TIER.  Leave a line blank to disable a provider;
#  JARVIS will simply skip it and fall back to the next one.
# ─────────────────────────────────────────────────────────────────────

# ── LLM providers (first available wins, in this order) ──
# Local, unlimited, private — the default brain.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=hermes3:3b

# Groq — free tier, very fast (console.groq.com/keys)
GROQ_API_KEY=
# Cerebras — free tier, fast (cloud.cerebras.ai)
CEREBRAS_API_KEY=
# OpenRouter — has free models (:free suffix)
OPENROUTER_API_KEY=
# Google AI Studio — generous free tier
GEMINI_API_KEY=
# Hugging Face Inference API — free monthly credits
HUGGINGFACE_API_KEY=

# ── Search (all free tiers) ──
# Tavily: 1 000 free searches/month   (app.tavily.com)
TAVILY_API_KEY=
# Serper: 2 500 one-time free credits (serper.dev)
SERPER_API_KEY=
# SearXNG: self-hosted, unlimited — point at your instance
SEARXNG_BASE_URL=
# Jina Reader: free tier for page reading (jina.ai/reader)
JINA_API_KEY=
# Firecrawl: 500 one-time free credits (firecrawl.dev)
FIRECRAWL_API_KEY=

# ── Browser / screen ──
# Path to Chrome/Chromium if it is not on PATH
JARVIS_CHROME_PATH=
# Set to 1 to run Chrome headless (no visible window)
JARVIS_HEADLESS=0

# ── Interfaces ──
JARVIS_API_HOST=127.0.0.1
JARVIS_API_PORT=8000
# Optional bearer token for the API server (strongly recommended if you bind 0.0.0.0)
JARVIS_API_TOKEN=

# ── Email (Gmail needs an App Password, not your login password) ──
JARVIS_SMTP_HOST=
JARVIS_SMTP_PORT=587
JARVIS_SMTP_USER=
JARVIS_SMTP_PASSWORD=
JARVIS_EMAIL_FROM=
JARVIS_SMTP_TLS=1

# ── Optional: any config value can be overridden with JARVIS__SECTION__KEY ──
# JARVIS__CONTEXT__MAX_BUDGET=12000
# JARVIS__SCREEN__FAILSAFE=false

# ── Obsidian (notes · flashcards · study planning) ─────────────────────────
# Your vault folder. JARVIS reads/writes plain markdown — no plugin required.
OBSIDIAN_VAULT=/home/heoster/Obsidian
